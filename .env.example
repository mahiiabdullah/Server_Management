# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 32
# Generate the DB password with hex (it goes into a URL):  openssl rand -hex 24

# ---- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
SESSION_SECRET=
CSRF_SECRET=
# First admin, created only while no user exists. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The address users open. Used for cookies and the Origin check.
PUBLIC_URL=https://monitor.example.com
# Networks a server's Node Exporter address may be in. Registration rejects anything
# else. Loopback, link-local, cloud metadata and the Docker networks are always refused.
# Public servers: list each one as /32, comma-separated, e.g. 51.38.55.124/32,51.38.55.125/32
ALLOWED_TARGET_CIDRS=51.38.55.124/32
ALLOWED_TARGET_PORTS=9100

# Set by docker-compose.yml; only needed when running the API outside Compose.
# DATABASE_URL=postgres://bm:PASSWORD@localhost:5432/bm?sslmode=disable
# PROMETHEUS_URL=http://localhost:9090
# TARGETS_FILE=./targets/fleet.json

# ---- Settings (not secrets) -------------------------------------------------
DEFAULT_SCRAPE_INTERVAL=30s
PROMETHEUS_RETENTION=30d
ALERT_EVAL_INTERVAL=30s
BILLING_TIMEZONE=UTC
BILLING_CURRENCY=USD
LOG_LEVEL=info
SESSION_IDLE_TIMEOUT=12h
SESSION_MAX_AGE=168h

# ---- Optional: TLS ----------------------------------------------------------
LETSENCRYPT_EMAIL=
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Optional: Google sign-in (Phase 6) -------------------------------------
# Redirect URI: PUBLIC_URL/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# ---- Optional: alert channels (Phase 5) — any one is enough ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Optional: provider billing APIs (Phase 4) -------------------------------
# Without these, only *estimated* cost is shown; *actual* comes from CSV upload.
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=
HETZNER_CLOUD_TOKEN=
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# ---- Optional: Node Exporter protection --------------------------------------
NODE_EXPORTER_BASIC_AUTH_USER=
NODE_EXPORTER_BASIC_AUTH_PASSWORD=
NODE_EXPORTER_CA_FILE=

# ---- Optional: error tracking ------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# ---- Local only: SSH tunnels to Node Exporters (docker-compose.local.yml) ----
# TUNNELS="19101=root@203.0.113.10 19102=ubuntu@203.0.113.11"
# TUNNEL_KEY_FILE=C:/Users/<you>/.ssh/bm_monitor_tunnel

# ---- Optional: SSH access workflow (docs/ACCESS.md) -------------------------
# Repository holding access/grants.yaml, and a GitHub App with Contents + Pull
# requests read/write on it ONLY (never Workflows). Create it with
# scripts/create-github-app.py; the key goes to secrets/gh-app.pem.
GITHUB_REPO=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Leave empty unless the App is set up; then: /run/bm-secrets/gh-app.pem
GITHUB_APP_PRIVATE_KEY_FILE=
# ...or a token of a separate bot account (not an admin's own; see docs/ACCESS.md):
GITHUB_TOKEN=
